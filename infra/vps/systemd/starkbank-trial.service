[Unit]
Description=Stark Bank Backend Trial
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/starkbank-trial
ExecStart=/usr/bin/make vps-deploy
ExecStop=/usr/bin/make vps-down
TimeoutStartSec=300
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
